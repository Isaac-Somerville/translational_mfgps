{
    "_description": "Heart rate: predict Human autonomic-block rate from Dog; held out on athletes.",
    "GP_type": "multitask",
    "noise_type": "homoskedastic",
    "mean_function": "linear",
    "num_repeats": 100,
    "num_iters": 200,
    "training_seed": 42,
    "subject_selection_seed": 42,
    "post_samples_seed": 42,
    "num_post_samples": 500,
    "num_post_concs": 100,
    "ard_num_dims": null,
    "covar_rank": 1,
    "k_fold_leave_out": 5,
    "qoi": "autonomic_block",
    "high_fidelity_species": "Human",
    "low_fidelity_species": [
        "Dog"
    ],
    "standardise_data": true,
    "run_human_only_comparison": true,
    "train_human_separately": true,
    "shared_noise": true,
    "shared_mean": true,
    "positive_mean": false,
    "ls_prior": {
        "loc": 2.28297,
        "scale": 0.198042
    },
    "index_kernel_prior": {
        "var_loc": -0.0430888,
        "var_scale": 0.29356,
        "scale": 1.0
    },
    "use_signed_mean": true,
    "leave_out_athletes": true
}
